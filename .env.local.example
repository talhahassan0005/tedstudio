# ---------------------------------------------------------------------------
# Cloudinary — storage, transform, delivery
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public (client-visible) copy of the cloud name, used by @cloudinary/url-gen
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Optional: unsigned upload preset, if you prefer unsigned client uploads
# over the signed flow served by /api/cloudinary/signature
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# AI providers (SERVER ONLY — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
CLIPDROP_API_KEY=
REPLICATE_API_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Workers AI (SERVER ONLY) — image generation, free daily quota.
# Account ID: Cloudflare dashboard -> right sidebar.
# API token: dash.cloudflare.com/profile/api-tokens -> "Workers AI" template.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: another text-to-image model, e.g. @cf/stabilityai/stable-diffusion-xl-base-1.0
CLOUDFLARE_IMAGE_MODEL=
# Optional: another inpainting model (default: @cf/runwayml/stable-diffusion-v1-5-inpainting)
CLOUDFLARE_INPAINT_MODEL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# FFmpeg — optional. Leave blank to use the bundled `ffmpeg-static` binary.
# Set it to an absolute path to use a system/custom ffmpeg instead, e.g.
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# ---------------------------------------------------------------------------
FFMPEG_PATH=
